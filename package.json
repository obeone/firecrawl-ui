{
  "name": "firecrawl-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "openapi-typescript https://docs.firecrawl.dev/api-reference/v2-openapi.json --empty-objects-unknown --default-non-nullable false -o src/types/firecrawl-v2.generated.ts",
    "api:types:check": "npm run api:types -- --check"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "dompurify": "^3.4.17",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "marked": "^18.1.3",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "^31.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.7"
  }
}
